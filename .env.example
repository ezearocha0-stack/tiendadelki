# ==============================================================================
# TIENDADELKI - PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN & DESARROLLO)
# ==============================================================================

# ==============================================================================
# 1. VARIABLES PARA VERCEL (FRONTEND PÚBLICO & PROXY API)
# ==============================================================================
# REGLA DE SEGURIDAD CRÍTICA:
# Vercel NUNCA debe tener configuradas DATABASE_URL ni DIRECT_URL.
# Todas las consultas a base de datos son exclusivas de Render.

# URL canónica del Frontend en Vercel y base de metadatos (canonical / OpenGraph):
# (Sin barra inclinada al final)
NEXT_PUBLIC_SITE_URL="https://tiendadelki.vercel.app"

# URL pública del backend en Render (hacia donde Vercel redirige /api/* y /uploads/*):
BACKEND_API_URL="https://tiendadelki-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://tiendadelki-backend.onrender.com"

# Clave Criptográfica JWT (OBLIGATORIA EN VERCEL):
# IMPORTANTE: Debe tener EXACTAMENTE EL MISMO VALOR que en Render para que el Edge
# Middleware de Vercel pueda verificar criptográficamente las cookies de sesión (td_auth_token).
JWT_SECRET="generar_con_openssl_rand_hex_32_en_terminal_debe_tener_64_caracteres"

# Nombre de la cookie de sesión HTTP-Only:
COOKIE_NAME="td_auth_token"

# Orígenes autorizados para CORS:
ALLOWED_ORIGINS="https://tiendadelki.vercel.app"

# Teléfono Oficial de WhatsApp de la Tienda (República Dominicana: 10 dígitos):
NEXT_PUBLIC_WHATSAPP_PHONE="8296734710"


# ==============================================================================
# 2. VARIABLES PARA RENDER (BACKEND / API / BASE DE DATOS POSTGRESQL - PLAN FREE)
# ==============================================================================
NODE_ENV=production
PORT=10000

# Conexión a Render PostgreSQL (Internal Connection String para alta velocidad y seguridad privada):
DATABASE_URL="postgres://tiendadelki_user:TU_PASSWORD_AQUI@dpg-placeholder-a/tiendadelki"
DIRECT_URL="postgres://tiendadelki_user:TU_PASSWORD_AQUI@dpg-placeholder-a/tiendadelki"

# Clave Criptográfica JWT (OBLIGATORIA EN RENDER):
# IMPORTANTE: Debe ser EXACTAMENTE IDÉNTICA a la configurada en Vercel.
JWT_SECRET="generar_con_openssl_rand_hex_32_en_terminal_debe_tener_64_caracteres"

# Nombre de la cookie de sesión HTTP-Only:
COOKIE_NAME="td_auth_token"

# URL canónica del frontend (para validar emisor 'iss' en JWT):
NEXT_PUBLIC_SITE_URL="https://tiendadelki.vercel.app"

# Orígenes autorizados para CORS:
ALLOWED_ORIGINS="https://tiendadelki.vercel.app"

# Almacenamiento de Archivos (100% Gratuito / Local en Contenedor):
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
PRIVATE_STORAGE_DIR="./storage/private"

# Credenciales del Administrador Inicial en la primera ejecución de seed (solo desarrollo):
INITIAL_ADMIN_EMAIL="admin@tiendadelki.com"
INITIAL_ADMIN_PASSWORD="TuPasswordSeguro123!#"
