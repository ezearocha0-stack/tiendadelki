# ==============================================================================
# TIENDADELKI - PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN & DESARROLLO)
# ==============================================================================

# ==============================================================================
# 1. VARIABLES PARA VERCEL (FRONTEND PÚBLICO - SIN SECRETOS DE SERVIDOR)
# ==============================================================================
# URL canónica del Frontend en Vercel y base de metadatos (canonical / OpenGraph):
NEXT_PUBLIC_SITE_URL="https://tiendadelki.vercel.app"
NEXT_PUBLIC_APP_URL="https://tiendadelki.vercel.app"


# URL pública del backend en Render (para llamadas API directas y proxy de Next.js):
NEXT_PUBLIC_API_URL="https://tiendadelki-backend.onrender.com"
BACKEND_API_URL="https://tiendadelki-backend.onrender.com"

# Teléfono Oficial de WhatsApp de la Tienda (República Dominicana: 10 dígitos)
NEXT_PUBLIC_WHATSAPP_PHONE="8296734710"

# ==============================================================================
# 2. VARIABLES PARA RENDER (BACKEND / API / STORAGE)
# ==============================================================================
NODE_ENV=production
PORT=10000

# Conexión a Neon PostgreSQL:
# 1. DATABASE_URL: Cadena con PgBouncer / Connection Pooling (para runtime y consultas de la app):
DATABASE_URL="postgresql://neondb_owner:TU_PASSWORD_AQUI@ep-placeholder-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Cadena directa sin pooling (para migraciones de Prisma 'prisma migrate deploy'):
DIRECT_URL="postgresql://neondb_owner:TU_PASSWORD_AQUI@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require"


# Llave Criptográfica JWT (OBLIGATORIO: Generar con `openssl rand -hex 32` - Mínimo 32 caracteres):
JWT_SECRET="generar_con_openssl_rand_hex_32_en_terminal_debe_tener_64_caracteres"

# Nombre de la cookie de sesión HTTP-Only:
COOKIE_NAME="td_auth_token"

# Orígenes autorizados para CORS (Dominio de Vercel y dominio propio):
ALLOWED_ORIGINS="https://tiendadelki.vercel.app,https://tiendadelki.com"

# Almacenamiento en Persistent Disk de Render:
STORAGE_PROVIDER="local"
UPLOAD_DIR="/data/tiendadelki/uploads"
PRIVATE_STORAGE_DIR="/data/tiendadelki/storage_private"

# Credenciales para el Administrador Inicial en la primera ejecución de seed:
INITIAL_ADMIN_EMAIL="admin@tiendadelki.com"
INITIAL_ADMIN_PASSWORD="TuPasswordSeguro123!#"

