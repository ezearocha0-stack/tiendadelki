# ==============================================================================
# TIENDADELKI - PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN & DESARROLLO)
# ==============================================================================

# Entorno de Ejecución ('development' | 'test' | 'production')
NODE_ENV=production
PORT=3000

# URL canónica con HTTPS en producción (sin slash final)
NEXT_PUBLIC_SITE_URL="https://tiendadelki.com"

# Conexión a PostgreSQL (con pooler o conexión directa con SSL en producción)
DATABASE_URL="postgresql://delki_user:PasswordComplejoYUnico2026!@127.0.0.1:5432/tiendadelki_prod?schema=public&sslmode=prefer"

# Llave Criptográfica JWT (OBLIGATORIO: Generar con `openssl rand -hex 32` - Mínimo 32 caracteres)
JWT_SECRET="e9c4b57a1d2f8e0a3b6c9d2f5a8e1b4c7d0a3f6e9c2b5a8d1f4e7a0b3c6d9e2f"

# Nombre de la cookie de sesión HTTP-Only
COOKIE_NAME="td_auth_token"

# Credenciales para el Administrador Inicial (sembrado inicial)
INITIAL_ADMIN_EMAIL="admin@tiendadelki.com"
INITIAL_ADMIN_PASSWORD="CambiarInmediatamente123!#"

# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS (PERSISTENCIA PARA PRODUCCIÓN)
# ==============================================================================
# Opciones para STORAGE_PROVIDER:
#  - "local": Almacena en disco del servidor (requiere volumen persistente en Docker/VPS)
#  - "r2": Cloudflare R2 (Object Storage S3-compatible económico y sin costos de egreso)
#  - "s3": AWS S3 o compatible (DigitalOcean Spaces, MinIO, Supabase)
STORAGE_PROVIDER="local"

# Si STORAGE_PROVIDER=local:
# Rutas recomendadas si se usa volumen persistente montado en VPS o Docker:
UPLOAD_DIR="/data/tiendadelki/uploads"
PRIVATE_STORAGE_DIR="/data/tiendadelki/storage_private"

# Si STORAGE_PROVIDER=s3 o r2 (descomentar y completar):
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_BUCKET="tiendadelki-assets"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="tu_access_key_id"
# S3_SECRET_ACCESS_KEY="tu_secret_access_key"
# S3_PUBLIC_URL="https://cdn.tiendadelki.com"

# Teléfono Oficial de WhatsApp de la Tienda (República Dominicana: 10 dígitos)
NEXT_PUBLIC_WHATSAPP_PHONE="8296734710"

# ==============================================================================
# DESPLIEGUE DISTRIBUIDO (VERCEL FRONTEND -> RENDER BACKEND)
# ==============================================================================
# En Vercel: URL pública del backend en Render para proxy inverso transparente:
# BACKEND_API_URL="https://tiendadelki-backend.onrender.com"
#
# En Render: Orígenes autorizados para CORS (dominio de Vercel):
# ALLOWED_ORIGINS="https://tiendadelki.vercel.app,https://tu-dominio.com"

